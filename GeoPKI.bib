	volume = {37},
	issn = {0149-0419},
	url = {https://doi.org/10.1080/01490419.2013.837849},
	doi = {10.1080/01490419.2013.837849},
	abstract = {{HMS} Challenger made the first sounding of Challenger Deep in 1875 of 8184 m. Many have since claimed depths deeper than Challenger's 8184 m, but few have provided details of how the determination was made. In 2010, the Mariana Trench was mapped with a Kongsberg Maritime {EM}122 multibeam echosounder and recorded the deepest sounding of 10,984 ± 25 m (95\%) at 11.329903°N/142.199305°E. The depth was determined with an update of the {HGM} uncertainty model combined with the Lomb-Scargle periodogram technique and a modal estimate of depth. Position uncertainty was determined from multiple {DGPS} receivers and a {POS}/{MV} motion sensor.},
	pages = {1--13},
	number = {1},
	journaltitle = {Marine Geodesy},
	author = {Gardner, James V. and Armstrong, Andrew A. and Calder, Brian R. and Beaudoin, Jonathan},
	urldate = {2023-04-03},
	date = {2014-01-02},
	note = {Publisher: Taylor \& Francis
\_eprint: https://doi.org/10.1080/01490419.2013.837849},
	keywords = {Challenger Deep, Mariana Trench, multibeam bathymetry},
	file = {Full Text PDF:/Users/tyratox/Zotero/storage/GBU9TLBJ/Gardner et al. - 2014 - So, How Deep Is the Mariana Trench.pdf:application/pdf},
}

